<UserControl x:Class="hotel.Common.Base.Btn"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:hotel.Common.Base"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800" x:Name="Myb">


    <Button Command="{Binding Command, ElementName=Myb}"
            Click="OnClick"
            Background="#999BD6"
           Foreground="WhiteSmoke"
            HorizontalContentAlignment="Center"
            VerticalAlignment="Center"
            Visibility="{Binding Visib,ElementName=Myb}"
            Content="{Binding Placeholder, ElementName=Myb}" 
            CommandParameter="{Binding Params, ElementName=Myb}"
            Width="{Binding Wigth, ElementName=Myb}" 
            Height="{Binding Heig,ElementName=Myb}"
            Margin="{Binding MarginSet, ElementName=Myb}"/>
</UserControl>