<UserControl x:Class="hotel.Common.Base.MySearch"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:hotel.Common.Base"
             mc:Ignorable="d" 
             xmlns:btn="clr-namespace:hotel.Common.Base"
             x:Name="SearchText"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Visibility="{Binding Visib, ElementName=SearchText}" Margin="5,0,5,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{Binding Wigth, ElementName=Myb}"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <TextBox  VerticalContentAlignment="Center"   Height="20"/>
            <btn:Btn  Grid.Column="1" Placeholder="{StaticResource searchstring}"  Heig="20" MarginSet="5,0,0,0"/>
       
    </Grid>
</UserControl>
