<UserControl x:Class="hotel.Common.Base.yCombobox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:hotel.Common.Base"
             mc:Ignorable="d" x:Name="cm"
             d:DesignHeight="450" d:DesignWidth="800">
    <WrapPanel Orientation="Horizontal">
        <ComboBox IsEditable="True" x:Name="MyBox"
                  
                  Width="{Binding Wigth, ElementName=cm}"
                  Height="{Binding Heig, ElementName=cm}"
                  IsTextSearchEnabled="False"
                  Text="{Binding Text, ElementName=cm}"
                    PreviewTextInput="MyBox_PreviewTextInput"
                  PreviewKeyUp="MyBox_PreviewKeyUp"
                  ItemsSource="{Binding ItemsSource, ElementName=cm}"
                  SelectedItem="{Binding SelectedItem, ElementName=cm}"
                  DisplayMemberPath="{Binding DisplayMemberPath, ElementName=cm}"
                  Margin="{Binding MarginSet, ElementName=cm}"
                  VerticalContentAlignment="Center"/>
        
    </WrapPanel>
</UserControl>
