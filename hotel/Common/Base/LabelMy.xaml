<UserControl x:Class="hotel.Common.Base.LabelMy"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:hotel.Common.Base"
             mc:Ignorable="d" 
                    d:Height="40" d:Width="250" >
    <Grid Margin="20,0,10,0"  Background="White" >
        <TextBlock x:Name="transtext" Panel.ZIndex="-1" Text="{Binding Placeholder}"  FontSize="16" FontWeight="Light" VerticalAlignment="Center" Foreground="LightGray" Margin="10,0,30,0" />
        <TextBox VerticalContentAlignment="Center" BorderBrush="Transparent" x:Name="txtMy" VerticalAlignment="Center" Margin="5,0,30,0" FontSize="16" FontWeight="Light" Background="Transparent" TextChanged="txtMy_TextChanged" Height="40"/>
        <Button Click="clearb_Click" x:Name="clearb" Height="40" Width="30" HorizontalAlignment="Right" Content="x" Foreground="LightGray" Background="Transparent" BorderBrush="Transparent"/>

    </Grid>
</UserControl>
