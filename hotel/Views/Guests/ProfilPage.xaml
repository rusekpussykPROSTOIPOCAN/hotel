<UserControl x:Class="hotel.Views.Guests.ProfilPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:hotel.Views.Guests"
             mc:Ignorable="d" 
             xmlns:btn="clr-namespace:hotel.Common.Base"
             xmlns:vm="clr-namespace:hotel.ViewModels.Guests"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.DataContext>
        <vm:ProfilViewModel/>
    </UserControl.DataContext>
    <Grid>
        <StackPanel CanVerticallyScroll="True">
            <btn:LabelMy Placeholder="{StaticResource Name}" Text="{Binding Name, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Margin="5"/>
            <btn:LabelMy Placeholder="{StaticResource Fname}" Text="{Binding Lname, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Margin="5"/>
            <btn:LabelMy Placeholder="{StaticResource MName}" Text="{Binding Mname, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Margin="5"/>
            <btn:LabelMy Placeholder="{StaticResource Log}" Text="{Binding Log, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Margin="5"/>
            <btn:LabelMy Placeholder="{StaticResource Passold}" Text="{Binding Oldpass, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Margin="5"/>
            <btn:LabelMy Placeholder="{StaticResource Pass}" Text="{Binding Pass, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Margin="5"/>

           
        <btn:Btn Placeholder="Сохранить" MarginSet="0,10,0,0" Command="{Binding SavePassCommand}"/>
        </StackPanel >
    </Grid>
</UserControl>
