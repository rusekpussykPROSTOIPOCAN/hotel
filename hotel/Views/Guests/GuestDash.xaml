<Window x:Class="hotel.Views.Guests.GuestDash"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:hotel.Views.Admin"
        mc:Ignorable="d"
     

            xmlns:btn="clr-namespace:hotel.Common.Base"
        xmlns:vm="clr-namespace:hotel.ViewModels.Guests"
        Title="AdminBoard" Height="500" Width="800">
    <Window.DataContext>
        <vm:GuestBoarsViewModel/>
    </Window.DataContext>

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="50" />
            <RowDefinition Height="*"/>
            <RowDefinition Height="50" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal" Grid.ColumnSpan="2" >

            <btn:Btn  Placeholder="{StaticResource profil}"   Command="{Binding GoToPageProfilCommand}" Wigth="110"/>
            <btn:Btn MarginSet="5,0,0,0"  Placeholder="{StaticResource  booking}" Command="{Binding GoToPageBookingCommand}"  Wigth="110"/>
            <btn:Btn  Placeholder="{StaticResource number}"  Command="{Binding MyNumCommand}" Wigth="120"/>


        </StackPanel>
            <btn:Btn Grid.Row="2" Placeholder="{StaticResource acceptbooking}" Visib="{Binding VisB}" Command="{Binding BookingCommand}" Wigth="120"/>
        <Button HorizontalAlignment="Left" Grid.Row="2" Margin="10,0,0,0" Content="Выйти" Click="Button_Click" Width="100" Height="30" Background="DarkCyan"/>
        <btn:DashBoasrdForAdmin Grid.Row="1" UserControl="{Binding CurrentPage}" Grid.ColumnSpan="2"/>
    </Grid>
</Window>