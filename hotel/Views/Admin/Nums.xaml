<UserControl x:Class="hotel.Views.Admin.Nums"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:hotel.Views.Admin"
        mc:Ignorable="d"
    
             xmlns:vm="clr-namespace:hotel.ViewModels.Admin"
   
        xmlns:btn="clr-namespace:hotel.Common.Base"
        Height="350" Width="600">
    <UserControl.DataContext>
        <vm:NumsViewModel/>
    </UserControl.DataContext>
    <Grid>
        <btn:DashBoasrdForAdmin Grid.Row="1" UserControl="{Binding Currentpage}"/>
        <DataGrid ItemsSource="{Binding Rooms}" Visibility="{Binding IsVis}" IsReadOnly="{Binding IsReadOnly}" x:Name="NumsTable" Grid.Row="1" AutoGenerateColumns="False">
                
            <DataGrid.Columns>
                <DataGridTextColumn Header="{StaticResource Num}" Binding="{Binding num}"/>
                <DataGridTextColumn Header="{StaticResource Card}" Binding="{Binding Card.Card_num}"/>
                <DataGridTextColumn Header="{StaticResource CountBads}" Binding="{Binding count_bad}"/>
                <DataGridTextColumn Header="{StaticResource Status}" Binding="{Binding StatusRoom.Status}"/>
                <DataGridTextColumn Header="{StaticResource NumType}" Binding="{Binding RoomType.Type}"/>
                <DataGridTextColumn Header="{StaticResource NFM}" Binding="{Binding Guest.FullName}"/>
                <DataGridTextColumn Header="{StaticResource DateCheckIn}" Binding="{Binding datein, StringFormat=yyyy-MM-dd }"/>
                <DataGridTextColumn Header="{StaticResource DateCheckOut}" Binding="{Binding dateout, StringFormat=yyyy-MM-dd}"/>
                <DataGridTextColumn Header="{StaticResource DateCheckOut}" Binding="{Binding PriceNigth}"/>
                <DataGridTemplateColumn Header="Действия">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <btn:Btn Visib="{Binding Guest.Check}" Placeholder="{StaticResource checkoutstring}" Params="{Binding}"  Command="{Binding 
                                    DataContext.checkoutCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                                <btn:Btn  Visib="{Binding Guest.Check1}" Placeholder="{StaticResource editguest}" Wigth="150" Params="{Binding}" Command="{Binding DataContext.editCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <btn:Btn Placeholder="Сохранить" Grid.Row="2"
                     Command="{Binding editCommand}" 
                     Visibility="{Binding IsVisEdit}" 
                     Width="150" Margin="5"/>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>
    </Grid>
</UserControl> 
