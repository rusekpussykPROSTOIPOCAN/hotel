<UserControl x:Class="hotel.Views.Admin.Nums"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:hotel.Views.Admin"
        mc:Ignorable="d"
    
             xmlns:vm="clr-namespace:hotel.ViewModels.Admin"
   
        xmlns:btn="clr-namespace:hotel.Common.Base"
        Height="350" Width="600">
    <UserControl.DataContext>
        <vm:NumsViewModel/>
    </UserControl.DataContext>
    <Grid>
        <btn:MySearch Visib="{Binding IsVis}" />
        <btn:DashBoasrdForAdmin Grid.Row="1" UserControl="{Binding Currentpage}"/>
        <DataGrid ItemsSource="{Binding Rooms}" Visibility="{Binding IsVis}" IsReadOnly="{Binding IsReadOnly}" x:Name="NumsTable" Grid.Row="1" AutoGenerateColumns="False">
                
            <DataGrid.Columns>
                <DataGridTextColumn Header="Номер" Binding="{Binding num}"/>
                <DataGridTextColumn Header="Карта" Binding="{Binding Card.Card_num}"/>
                <DataGridTextColumn Header="Количество мест" Binding="{Binding count_bad}"/>
                <DataGridTextColumn Header="Статус" Binding="{Binding StatusRoom.Status}"/>
                <DataGridTextColumn Header="Тип комнаты" Binding="{Binding RoomType.Type}"/> 
                <DataGridTextColumn Header="Гость" Binding="{Binding Guest.FullName}"/>
                <DataGridTemplateColumn Header="Действия">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <btn:Btn Visib="{Binding Guest.Check}" Placeholder="{StaticResource checkoutstring}" Command="{Binding checkoutCommand}" />
                                <btn:Btn Placeholder="{StaticResource editguest}" Wigth="150" Command="{Binding editCommand}" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
        <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" Grid.Row="2">
            <btn:Btn Placeholder="{StaticResource checkinstring}" Command="{Binding checkinCommand}" Visib="{Binding IsVischeckin}"/>
           
        </StackPanel>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>
    </Grid>
</UserControl> 
