<UserControl x:Class="hotel.Views.Admin.Nums"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:hotel.Views.Admin"
        mc:Ignorable="d"
             xmlns:vm="clr-namespace:hotel.ViewModels.Admin"
        xmlns:con="clr-namespace:hotel.Common.Base"
        xmlns:btn="clr-namespace:hotel.Common.Base"
        Height="350" Width="600">
    <UserControl.DataContext>
        <vm:NumsViewModel/>
    </UserControl.DataContext>
    <Grid>
        <con:DashBoasrdForAdmin Grid.Row="0" UserControl="{Binding Currentpage}"/>
        <DataGrid Visibility="{Binding IsVis}" IsReadOnly="{Binding IsReadOnly}" x:Name="NumsTable" Grid.Row="0" AutoGenerateColumns="False">
                
            <DataGrid.Columns>
                <DataGridTextColumn />
                <DataGridTextColumn />
                <DataGridTextColumn />
                <DataGridTextColumn />

            </DataGrid.Columns>
        </DataGrid>
        <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" Grid.Row="1">
            <btn:Btn Placeholder="{StaticResource checkinstring}" Command="{Binding checkinCommand}" Visib="{Binding IsVischeckin}"/>
            <btn:Btn Placeholder="{StaticResource checkoutstring}" Command="{Binding checkoutCommand}" Visib="{Binding IsVischeckout}"/>
            <btn:Btn Placeholder="{StaticResource editguest}" Wigth="150" Command="{Binding editCommand}" Visib="{Binding IsVisEdit}"/>
        </StackPanel>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>
    </Grid>
</UserControl> 
