<Window x:Class="hotel.Views.Admin.AdminBoard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:hotel.Views.Admin"
        mc:Ignorable="d"
     

            xmlns:btn="clr-namespace:hotel.Common.Base"
        xmlns:vm="clr-namespace:hotel.ViewModels.Admin"
        Title="AdminBoard" Height="500" Width="800">
    <Window.DataContext>
        <vm:AdminBoardModel/>
    </Window.DataContext>
    
    <Grid>
       
        <Grid.RowDefinitions>
            <RowDefinition Height="50" />
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal" Grid.ColumnSpan="2" >

            <btn:Btn MarginSet="5"  Placeholder="{StaticResource  bookingtext}" Command="{Binding ShowFirstCommand}"  Wigth="110"/>
            <btn:Btn  Placeholder="{StaticResource gueststext}"   Command="{Binding ShowSecondCommand}" Wigth="110"/>
            <btn:Btn  Placeholder="{StaticResource numstext}"  Command="{Binding ShowThirdCommand}" Wigth="120"/>
            <btn:Btn   Placeholder="{StaticResource scheduletext}" Command="{Binding ShowFivethCommand}"  Wigth="120"/>

            <btn:Btn   Placeholder="{StaticResource taskstext}" Command="{Binding ShowSixthCommand}"  Wigth="120"/>
            <btn:Btn  Placeholder="{StaticResource selltext}"  Command="{Binding ShowFourthCommand}"   Wigth="120"/>
        </StackPanel>
        <btn:DashBoasrdForAdmin Grid.Row="1" UserControl="{Binding CurrentPage}" Grid.ColumnSpan="2"/>
    </Grid>
</Window>
