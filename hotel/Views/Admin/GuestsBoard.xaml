<UserControl x:Class="hotel.Views.Admin.GuestsBoard"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:hotel.Views.Admin"
        mc:Ignorable="d"
        xmlns:btn="clr-namespace:hotel.Common.Base"
        xmlns:vm ="clr-namespace:hotel.ViewModels.Admin"
         Height="350" Width="600">
    <UserControl.DataContext>
        <vm:GuestsViewModel/>
    </UserControl.DataContext>
    <Grid>

        <btn:MySearch Visib="{Binding IsVis}"  Grid.Row="0"/>
        <btn:DashBoasrdForAdmin UserControl="{Binding Currentpage}" Grid.Row="1"/>
        <DataGrid ItemsSource="{Binding Guest}" EnableColumnVirtualization="True" EnableRowVirtualization="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"   Grid.Row="1" AutoGenerateColumns="False" Visibility="{Binding IsVis}" IsReadOnly="{Binding IsReadOnly}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Имя" Binding="{Binding Name}" />
                <DataGridTextColumn Header="Фамилия" Binding="{Binding Lname}"/>
                <DataGridTextColumn  Header="Отчество" Binding="{Binding Mname}"/>
                <DataGridTextColumn   Header="Дата рождения" Binding="{Binding Birthday,StringFormat=\{0:d\}}"/>
                <DataGridTemplateColumn  Header="Дейсвие">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <btn:Btn Placeholder="{StaticResource editguests}" Command="{Binding DataContext.EditGuestCommand, 
                  RelativeSource={RelativeSource AncestorType=DataGrid}}" Params="{Binding}" Wigth="150"  />
                                <btn:Btn Placeholder="{StaticResource deleteguest}" Command="{Binding DataContext.DeleteGuestCommand, 
                  RelativeSource={RelativeSource AncestorType=DataGrid}}" Params="{Binding}"  Wigth="100"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
        <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" Grid.Row="2">
            <btn:Btn Placeholder="{StaticResource addguest}" Command="{Binding AddGuestCommand}" Visibility="{Binding IsVisGuestAdd}" Wigth="150"/>
           
          
        </StackPanel>
        <Grid.RowDefinitions>
            <RowDefinition Height="35"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          
        </Grid.RowDefinitions>
    </Grid>
</UserControl>
