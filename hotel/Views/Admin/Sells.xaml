<UserControl x:Class="hotel.Views.Admin.Sells"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:hotel.Views.Admin"
        mc:Ignorable="d"
        xmlns:vm="clr-namespace:hotel.ViewModels.Admin"
        xmlns:btn="clr-namespace:hotel.Common.Base"
         Height="350" Width="600">
    <UserControl.DataContext>
        <vm:SellsViewModel/>
    </UserControl.DataContext>
    <Grid>
        <btn:MySearch Grid.Row="0" Visib="{Binding IsVis}"/>
        <btn:DashBoasrdForAdmin UserControl="{Binding Currentpage}" Grid.Row="1" />
        <DataGrid Visibility="{Binding IsVis}" IsReadOnly="{Binding IsReadOnly}" x:Name="NumsTable" Grid.Row="1" AutoGenerateColumns="False">

            <DataGrid.Columns>
                <DataGridTextColumn />
                <DataGridTextColumn />
                <DataGridTextColumn />
                <DataGridTextColumn />
                <DataGridTemplateColumn>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <btn:Btn Placeholder="{StaticResource deletesell}"  Wigth="120" Command="{Binding deleteCommand}" Params="{Binding}" />
                                <btn:Btn Placeholder="{StaticResource editsell}" Wigth="150" Command="{Binding editCommand}" Params="{Binding}"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
        <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" Grid.Row="2">
            <btn:Btn Placeholder="{StaticResource addsell}"  Wigth="120" Command="{Binding addCommand}" Visib="{Binding IsVisAdd}"/>
            
        </StackPanel>
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>
    </Grid>
</UserControl>
