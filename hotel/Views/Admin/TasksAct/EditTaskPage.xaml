<UserControl x:Class="hotel.Views.Admin.TasksAct.EditTaskPage"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
xmlns:local="clr-namespace:hotel.Views.Admin.GuestAct"
      xmlns:btn="clr-namespace:hotel.Common.Base"
mc:Ignorable="d"
     xmlns:vm="clr-namespace:hotel.ViewModels.Admin.TaskActViewModels"
 Height="Auto" Width="Auto">
    <UserControl.DataContext>
        <vm:TaskEditViewModel/>
    </UserControl.DataContext>
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">

            <StackPanel CanVerticallyScroll="True">

                <btn:LabelMy Placeholder="{StaticResource TaskDisk}" Text="{Binding Disc, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Margin="5"/>
                <btn:yCombobox ItemsSource="{Binding Staff}" SelectedItem="{Binding SelectedStaff,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" DisplayMemberPath="FullName" Wigth="550" Margin="20,0,10,0"/>
                <btn:yCombobox ItemsSource="{Binding Stask}" SelectedItem="{Binding Selectedstask, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" DisplayMemberPath="StatusTask" Wigth="550" Margin="20,0,10,0"/>

            </StackPanel >
        </ScrollViewer>
    </Grid>
</UserControl>
