        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:hotel.Views.Admin.NumsAct"
        mc:Ignorable="d"
               xmlns:btn="clr-namespace:hotel.Common.Base"
         Height="Auto" Width="600">
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">

            <StackPanel CanVerticallyScroll="True">
                <DatePicker Text="{StaticResource DateCheckIn}" Margin="25,0,30,5"/>
                <DatePicker Text="{StaticResource DateCheckOut}" Margin="25,0,30,0"/>
                <btn:yCombobox  Wigth="545"  Margin="20,0,10,0"/>
                <btn:yCombobox  Wigth="545"  Margin="20,0,10,0"/>
                <btn:yCombobox  Wigth="545"  Margin="20,0,10,0"/>
                <btn:yCombobox  Wigth="545"  Margin="20,0,10,0"/>
                <btn:yCombobox  Wigth="545"  Margin="20,0,10,0"/>
               

            </StackPanel >
        </ScrollViewer>
    </Grid>
</UserControl>
