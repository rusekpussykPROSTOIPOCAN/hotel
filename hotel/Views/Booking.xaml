<UserControl x:Class="hotel.Views.Booking"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:hotel.Views.Admin"
        mc:Ignorable="d"
        xmlns:btn="clr-namespace:hotel.Common.Base"
xmlns:vm ="clr-namespace:hotel.ViewModels"
         Height="350" Width="600">
    <UserControl.DataContext>
        <vm:BookingViewModel/>
    </UserControl.DataContext>
    <Grid>

        <btn:MySearch  Grid.Row="0" Visib="{Binding Vis2}"/>
        <DataGrid IsReadOnly="True" ItemsSource="{Binding Booking}" Grid.Row="1" AutoGenerateColumns="False" Visibility="{Binding Vis2}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Дата Бронирования" Binding="{Binding date,StringFormat=\{0:d\}}" />
                <DataGridTextColumn Header="Номер комнаты" Binding="{Binding RoomModel.num}"/>
                <DataGridTextColumn Header="Гость" Binding="{Binding usersModel.FullName}"/>
                <DataGridTextColumn Header="Статус" Binding="{Binding Status.Status }"/>
                <DataGridTemplateColumn Header="Действия">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <btn:Btn Placeholder="{StaticResource acceptbooking}" Wigth="150"  Params="{Binding}"/>
                                <btn:Btn Placeholder="{StaticResource deletebooking}"  Wigth="120"  Params="{Binding}" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
        <ScrollViewer Visibility="{Binding Vis1}" VerticalScrollBarVisibility="Auto">

            <StackPanel CanVerticallyScroll="True">
                <btn:LabelMy Placeholder="{StaticResource Name}" Text="{Binding Name, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Margin="5"/>
                <btn:LabelMy Placeholder="{StaticResource Fname}" Text="{Binding Lname, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Margin="5"/>
                <btn:LabelMy Placeholder="{StaticResource MName}" Text="{Binding Mname, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Margin="5"/>
                <btn:LabelMy Placeholder="{StaticResource SeriaandNum}" Text="{Binding Sernum, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Margin="5"/>
                <btn:LabelMy Placeholder="{StaticResource Log}" Text="{Binding Log, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Margin="5"/>
                <btn:LabelMy Placeholder="{StaticResource Pass}" Text="{Binding Pass, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Margin="5"/>
                <btn:LabelMy Placeholder="{StaticResource Pass}" Text="{Binding Pass, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Margin="5"/>
                <ComboBox Margin="25,0,15,0" Height="40"/>

                <DatePicker SelectedDate="{Binding Birthday, StringFormat=yyyy-MM-dd}" 
      BorderBrush="Transparent" 
      Margin="25,5,10,5" />

            </StackPanel >
        </ScrollViewer>
        <Grid.RowDefinitions>
            <RowDefinition Height="35"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
    </Grid>
</UserControl>
