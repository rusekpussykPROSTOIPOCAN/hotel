<UserControl x:Class="hotel.Views.Staff.Tasks"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:hotel.Views.Staff"
        mc:Ignorable="d"
         Height="450" Width="800">
    <Grid>
        <DataGrid AutoGenerateColumns="False">
            <DataGrid.Columns>
                <DataGridTextColumn />
                <DataGridTextColumn />
                <DataGridTextColumn />
            </DataGrid.Columns>
        </DataGrid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
    </Grid>
    <!--сделать появление кнопки для выдачи задания на уборку при статусе "грязно" и менять статус если кто-то взял задание на "в работе" смена статуса на "убрано", если таск отмечен выполненным-->
</UserControl>
