<Window x:Class="hotel.Views.Staff.StaffBoard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:hotel.Views.Staff"
        mc:Ignorable="d"
        xmlns:vm="clr-namespace:hotel.ViewModels.Staff"
        xmlns:btn="clr-namespace:hotel.Common.Base"
        Title="StaffBoard" Height="450" Width="800">
    <Window.DataContext>
        <vm:StaffBoardViewModel/>
    </Window.DataContext>
    <Grid>
       

            <Grid.RowDefinitions>
              
                <RowDefinition Height="*"/>
                <RowDefinition Height="30"/>
            </Grid.RowDefinitions>

        <Button HorizontalAlignment="Left" Grid.Row="2" Margin="10,0,0,0" Content="Выйти" Click="Button_Click" Width="100" Height="30" Background="DarkCyan"/>
        <btn:DashBoasrdForAdmin  UserControl="{Binding Current}" Grid.ColumnSpan="2"/>
        
    </Grid>
</Window>
