<Window x:Class="hotel.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:hotel"
        mc:Ignorable="d"
             xmlns:btn="clr-namespace:hotel.Common.Base"
         xmlns:textbox="clr-namespace:hotel.Common.Base"
           Title="" Height="450" Width="400">
    
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
        </Grid.RowDefinitions>

        <Label Grid.Column="0" Grid.Row="0" Grid.ColumnSpan="3"  HorizontalAlignment="Center" Content="{StaticResource Hello}"/>
        <textbox:LabelMy Grid.Column="0" Grid.Row="1" Grid.ColumnSpan="3" Placeholder="{StaticResource Log}"/>
        <textbox:LabelMy Grid.Column="0" Grid.Row="2" Grid.ColumnSpan="3" Placeholder="{StaticResource Pass}"/>

        <btn:Btn  Grid.Row="3" Grid.ColumnSpan="3"  Placeholder="{StaticResource entry}" Click="Button_Click" Wigth="300" Margin="50,3,50,-4"/>



    </Grid>
</Window>
